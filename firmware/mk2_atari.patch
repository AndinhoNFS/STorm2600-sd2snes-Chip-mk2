+static void a26_fe_byte(a26_scan_t *st, uint8_t b) {
+  uint8_t s;
+  if(st->fe_seen >= 2 && st->fe_hist[2] == 0x8D && st->fe_hist[3] == 0xF9) {
+    if(b == 0x1F && st->f8_sta[0] < 255) st->f8_sta[0]++;
+    if(b == 0xFF && st->f8_sta[1] < 255) st->f8_sta[1]++;
